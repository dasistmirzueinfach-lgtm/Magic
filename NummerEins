```react
import React, { useState, useEffect, useRef, useMemo } from 'react';
import { initializeApp } from 'firebase/app';
import { 
  getFirestore, 
  collection, 
  doc, 
  onSnapshot, 
  addDoc, 
  updateDoc, 
  deleteDoc, 
  signInAnonymously, 
  signInWithCustomToken, 
  getAuth, 
  onAuthStateChanged 
} from 'firebase/auth';
import { 
  getFirestore as getDb, 
  collection as fireCol, 
  doc as fireDoc, 
  query, 
  where 
} from 'firebase/firestore';
import { 
  Search, Library, Layout, Sparkles, Plus, Trash2, ChevronRight, 
  Loader2, X, Camera, Scan, DollarSign, FolderPlus, Folder, 
  ChevronLeft, Move, Send, User, Bot, AlertTriangle 
} from 'lucide-react';

// --- Firebase Setup (Safe Parse) ---
let firebaseConfig = {};
try {
  firebaseConfig = JSON.parse(__firebase_config);
} catch (e) {
  console.error("Firebase config missing or invalid");
}

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getDb(app);
const appId = typeof __app_id !== 'undefined' ? __app_id : 'manacraft-debug-v1';
const API_KEY = ""; // Provided at runtime
const GEMINI_MODEL = "gemini-2.5-flash-preview-09-2025";

const App = () => {
  const [user, setUser] = useState(null);
  const [activeTab, setActiveTab] = useState('search');
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  
  const [collectionData, setCollectionData] = useState([]);
  const [folders, setFolders] = useState([]);
  const [decks, setDecks] = useState([]);
  const [searchResults, setSearchResults] = useState([]);
  const [searchQuery, setSearchQuery] = useState('');
  const [isSearching, setIsSearching] = useState(false);
  const [selectedFolderId, setSelectedFolderId] = useState(null);
  
  const [messages, setMessages] = useState([
    { role: 'bot', text: 'Hallo Fabian! Ich bin bereit. Falls etwas nicht funktioniert, sag mir Bescheid.' }
  ]);
  const [chatInput, setChatInput] = useState('');
  const [isTyping, setIsTyping] = useState(false);
  
  const [showScanner, setShowScanner] = useState(false);
  const [isScanning, setIsScanning] = useState(false);
  
  const videoRef = useRef(null);
  const canvasRef = useRef(null);
  const chatEndRef = useRef(null);

  // --- RULE 3: Auth Before Queries ---
  useEffect(() => {
    const initAuth = async () => {
      try {
        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
          await signInWithCustomToken(auth, __initial_auth_token);
        } else {
          await signInAnonymously(auth);
        }
      } catch (err) {
        setError("Authentifizierung fehlgeschlagen: " + err.message);
      }
    };
    initAuth();
    const unsubscribe = onAuthStateChanged(auth, (u) => {
      setUser(u);
      if (u) setLoading(false);
    });
    return () => unsubscribe();
  }, []);

  // --- RULE 1: Strict Paths for Data Sync ---
  useEffect(() => {
    if (!user) return;

    // Collection Sync
    const colPath = fireCol(db, 'artifacts', appId, 'users', user.uid, 'collection');
    const unsubCol = onSnapshot(colPath, 
      (s) => setCollectionData(s.docs.map(d => ({ id: d.id, ...d.data() }))),
      (err) => setError("Fehler beim Laden der Sammlung: " + err.message)
    );

    // Folders Sync
    const folderPath = fireCol(db, 'artifacts', appId, 'users', user.uid, 'folders');
    const unsubFolders = onSnapshot(folderPath, 
      (s) => setFolders(s.docs.map(d => ({ id: d.id, ...d.data() })))
    );

    // Decks Sync
    const deckPath = fireCol(db, 'artifacts', appId, 'users', user.uid, 'decks');
    const unsubDecks = onSnapshot(deckPath, 
      (s) => setDecks(s.docs.map(d => ({ id: d.id, ...d.data() })))
    );

    return () => { unsubCol(); unsubFolders(); unsubDecks(); };
  }, [user]);

  useEffect(() => {
    chatEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [messages, isTyping]);

  // --- Search Logic ---
  const handleSearch = async (e) => {
    if (e) e.preventDefault();
    if (!searchQuery.trim()) return;
    setIsSearching(true);
    try {
      const res = await fetch(`https://api.scryfall.com/cards/search?q=${encodeURIComponent(searchQuery)}`);
      const data = await res.json();
      setSearchResults(data.data || []);
    } catch (err) {
      setError("Suche fehlgeschlagen: " + err.message);
    } finally {
      setIsSearching(false);
    }
  };

  // --- AI Bot Logic ---
  const sendToBot = async (e) => {
    if (e) e.preventDefault();
    if (!chatInput.trim() || isTyping) return;
    const text = chatInput.trim();
    setMessages(p => [...p, { role: 'user', text }]);
    setChatInput('');
    setIsTyping(true);

    try {
      const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_MODEL}:generateContent?key=${API_KEY}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          contents: [{ parts: [{ text }] }],
          systemInstruction: { parts: [{ text: "Du bist ManaBot. Hilf Fabian mit MTG Tipps. Antworte kurz auf Deutsch." }] }
        })
      });
      const data = await res.json();
      const reply = data.candidates?.[0]?.content?.parts?.[0]?.text || "Ich konnte dich leider nicht verstehen.";
      setMessages(p => [...p, { role: 'bot', text: reply }]);
    } catch (err) {
      setMessages(p => [...p, { role: 'bot', text: "KI-Verbindungsproblem." }]);
    } finally {
      setIsTyping(false);
    }
  };

  // --- Camera Logic ---
  const toggleScanner = async () => {
    if (showScanner) {
      if (videoRef.current?.srcObject) {
        videoRef.current.srcObject.getTracks().forEach(t => t.stop());
      }
      setShowScanner(false);
    } else {
      setShowScanner(true);
      try {
        const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } });
        if (videoRef.current) videoRef.current.srcObject = stream;
      } catch (err) {
        setError("Kamerazugriff wurde verweigert.");
        setShowScanner(false);
      }
    }
  };

  if (error) {
    return (
      <div className="h-screen bg-slate-950 flex flex-col items-center justify-center p-6 text-center">
        <AlertTriangle className="text-red-500 mb-4" size={48} />
        <h1 className="text-xl font-bold text-white mb-2">Hoppla! Da stimmt was nicht.</h1>
        <p className="text-slate-400 text-sm mb-6">{error}</p>
        <button onClick={() => window.location.reload()} className="bg-blue-600 px-6 py-2 rounded-xl font-bold">App neu starten</button>
      </div>
    );
  }

  const currentCards = collectionData.filter(c => c.folderId === selectedFolderId);

  return (
    <div className="flex flex-col h-screen bg-black text-slate-100 font-sans overflow-hidden">
      {/* Header */}
      <header className="px-5 py-4 bg-slate-900 border-b border-white/5 flex justify-between items-center z-40 shrink-0">
        <div className="flex items-center gap-2">
          <div className="bg-blue-600 p-1.5 rounded-lg"><Sparkles size={18} /></div>
          <h1 className="text-sm font-black tracking-widest uppercase italic text-blue-400">ManaCraft</h1>
        </div>
        <button onClick={toggleScanner} className="p-2 bg-slate-800 rounded-full">
          <Camera size={18} className="text-blue-400" />
        </button>
      </header>

      {/* Main Content */}
      <main className="flex-1 overflow-y-auto pb-24">
        {activeTab === 'search' && (
          <div className="p-4 space-y-4">
            <form onSubmit={handleSearch} className="flex gap-2">
              <input 
                type="text" 
                placeholder="Karte suchen..." 
                className="flex-1 bg-slate-900 border border-white/10 rounded-xl px-4 py-3 text-sm focus:ring-2 focus:ring-blue-500 outline-none"
                value={searchQuery}
                onChange={(e) => setSearchQuery(e.target.value)}
              />
              <button type="submit" className="bg-blue-600 px-4 rounded-xl font-bold">Go</button>
            </form>

            {isSearching ? (
              <div className="flex justify-center py-10"><Loader2 className="animate-spin text-blue-500" /></div>
            ) : (
              <div className="grid grid-cols-1 gap-3">
                {searchResults.map(card => (
                  <div key={card.id} className="bg-slate-900 border border-white/5 rounded-xl flex overflow-hidden">
                    <img src={card.image_uris?.normal || card.card_faces?.[0]?.image_uris?.normal} className="w-16 object-cover" />
                    <div className="p-3 flex-1 flex justify-between items-center">
                      <span className="text-xs font-bold truncate max-w-[150px]">{card.name}</span>
                      <button 
                        onClick={() => addDoc(fireCol(db, 'artifacts', appId, 'users', user.uid, 'collection'), { 
                          scryfallId: card.id, folderId: selectedFolderId, name: card.name, 
                          image: card.image_uris?.normal || card.card_faces?.[0]?.image_uris?.normal, count: 1 
                        })} 
                        className="bg-blue-600/20 text-blue-400 p-1.5 rounded-lg"
                      >
                        <Plus size={16}/>
                      </button>
                    </div>
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {activeTab === 'collection' && (
          <div className="p-4 space-y-4">
             <div className="flex justify-between items-center">
                <div className="flex items-center gap-2">
                   {selectedFolderId && <button onClick={() => setSelectedFolderId(null)}><ChevronLeft size={20}/></button>}
                   <h2 className="font-black uppercase tracking-widest">{selectedFolderId ? folders.find(f => f.id === selectedFolderId)?.name : 'Sammlung'}</h2>
                </div>
                <button onClick={() => { const n = prompt("Ordner Name:"); if(n) addDoc(fireCol(db, 'artifacts', appId, 'users', user.uid, 'folders'), { name: n }); }}><FolderPlus size={20} className="text-blue-400"/></button>
             </div>
             
             {!selectedFolderId && (
               <div className="grid grid-cols-2 gap-2">
                  {folders.map(f => (
                    <div key={f.id} onClick={() => setSelectedFolderId(f.id)} className="bg-slate-900 p-4 rounded-xl flex flex-col items-center border border-white/5 shadow-lg active:scale-95 transition-all">
                      <Folder size={24} className="text-blue-500 mb-1"/>
                      <span className="text-[10px] font-bold truncate w-full text-center">{f.name}</span>
                    </div>
                  ))}
               </div>
             )}

             <div className="grid grid-cols-2 gap-3">
               {currentCards.map(c => (
                 <div key={c.id} className="relative rounded-lg overflow-hidden border border-white/5 group shadow-xl">
                   <img src={c.image} className="w-full aspect-[3/4] object-cover"/>
                   <div className="absolute top-1 left-1 bg-blue-600 px-1.5 rounded text-[8px] font-black">x{c.count}</div>
                   <div className="absolute bottom-0 left-0 right-0 p-1 bg-black/70 flex justify-between items-center">
                     <span className="text-[8px] truncate flex-1">{c.name}</span>
                     <button onClick={() => deleteDoc(fireDoc(db, 'artifacts', appId, 'users', user.uid, 'collection', c.id))} className="text-red-500"><Trash2 size={10}/></button>
                   </div>
                 </div>
               ))}
             </div>
          </div>
        )}

        {activeTab === 'ai' && (
          <div className="flex flex-col h-[calc(100vh-160px)]">
            <div className="flex-1 overflow-y-auto p-4 space-y-4">
              {messages.map((m, i) => (
                <div key={i} className={`flex ${m.role === 'user' ? 'justify-end' : 'justify-start'}`}>
                  <div className={`p-3 rounded-xl text-xs max-w-[80%] shadow-lg ${m.role === 'user' ? 'bg-blue-600' : 'bg-slate-900 border border-white/5'}`}>{m.text}</div>
                </div>
              ))}
              {isTyping && <div className="p-2 bg-slate-900/50 rounded-lg w-10 flex justify-center"><Loader2 size={14} className="animate-spin" /></div>}
              <div ref={chatEndRef} />
            </div>
            <form onSubmit={sendToBot} className="p-4 bg-slate-900/80 border-t border-white/5 flex gap-2">
              <input 
                type="text" 
                className="flex-1 bg-black border border-white/10 rounded-xl px-4 py-2 text-xs" 
                placeholder="Frag ManaBot..."
                value={chatInput} 
                onChange={(e) => setChatInput(e.target.value)} 
              />
              <button type="submit" className="bg-blue-600 p-2 rounded-xl shadow-lg active:scale-90"><Send size={16}/></button>
            </form>
          </div>
        )}
      </main>

      {/* Navigation */}
      <nav className="fixed bottom-0 left-0 right-0 p-4 bg-slate-950/90 backdrop-blur-md border-t border-white/5 flex justify-around items-center">
        <NavBtn id="search" icon={Search} active={activeTab} onClick={setActiveTab} />
        <NavBtn id="collection" icon={Library} active={activeTab} onClick={setActiveTab} />
        <NavBtn id="ai" icon={Sparkles} active={activeTab} onClick={setActiveTab} />
      </nav>

      {/* Scanner Modal */}
      {showScanner && (
        <div className="fixed inset-0 z-50 bg-black flex flex-col">
          <video ref={videoRef} autoPlay playsInline className="flex-1 object-cover" />
          <div className="p-8 bg-slate-900 flex flex-col items-center gap-4">
            <button 
              onClick={captureScan} 
              disabled={isScanning} 
              className="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center border-4 border-slate-800 shadow-2xl active:scale-95"
            >
              {isScanning ? <Loader2 className="animate-spin"/> : <Scan size={32}/>}
            </button>
            <button onClick={toggleScanner} className="text-xs text-slate-500 font-bold uppercase tracking-widest">Schließen</button>
          </div>
          <canvas ref={canvasRef} className="hidden" />
        </div>
      )}

      {loading && (
        <div className="fixed inset-0 bg-black z-[100] flex flex-col items-center justify-center">
          <Loader2 className="animate-spin text-blue-500 mb-4" size={40} />
          <p className="text-xs font-bold tracking-widest text-slate-500 uppercase">Verbindung wird aufgebaut...</p>
        </div>
      )}
    </div>
  );
};

const NavBtn = ({ id, icon: Icon, active, onClick }) => (
  <button onClick={() => onClick(id)} className={`p-3 rounded-xl transition-all ${active === id ? 'bg-blue-600 text-white shadow-lg' : 'text-slate-500'}`}>
    <Icon size={20}/>
  </button>
);

export default App;

```
